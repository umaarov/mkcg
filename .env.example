# copy to .env on the server
CG_SECRET_KEY=
# optional: external model for the prototype (production design runs fully local)
CG_ANTHROPIC_API_KEY=
# or any OpenAI-compatible hosted API, e.g. DeepSeek (external: masked text only, blocked in perimeter mode)
CG_OPENAI_BASE_URL=
CG_OPENAI_API_KEY=
CG_PERIMETER_MODE=false
# optional on-prem model endpoint (OpenAI-compatible: vLLM / Ollama), e.g. http://llm:8000/v1
CG_LOCAL_BASE_URL=
WEB_PORT=3101
PUBLIC_HOST=
