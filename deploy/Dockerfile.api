FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr curl libgomp1 \
    && rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir uv
WORKDIR /srv
COPY apps/api/pyproject.toml apps/api/uv.lock apps/api/
RUN cd apps/api && uv sync --frozen --no-dev
COPY apps/api apps/api
COPY eval/results eval/results
COPY scripts scripts
RUN sh scripts/get_tessdata.sh /srv/data/tessdata >/dev/null
ENV CG_DATA_DIR=/data PYTHONUNBUFFERED=1 OMP_THREAD_LIMIT=1
VOLUME /data
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD curl -fs http://localhost:8000/api/health || exit 1
WORKDIR /srv/apps/api
CMD ["uv", "run", "--no-sync", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
